# Leave NEXT_PUBLIC_API_BASE_URL empty on Vercel so the frontend uses same-origin /api routes.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_USE_MOCKS=false

# Configure these as Vercel environment variables, not in client code.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_ASR_MODEL=openai/whisper-large-v3
OPENROUTER_ASR_URL=https://openrouter.ai/api/v1/audio/transcriptions
